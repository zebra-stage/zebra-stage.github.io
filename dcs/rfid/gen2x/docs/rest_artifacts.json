                      },
                      "action": {
                        "type": "string",
                        "description": "Action to perform on the target. For target SL, provide an SL action using ASSERTSL, DEASSERTSL, or NEGATESL. For targets S0, S1, S2, or S3, provide a session action using INVA, INVB, or FLIPAB.",
                        "enum": [
                          "ASSERTSL_DEASSERTSL",
                          "ASSERTSL_NOTHING",
                          "NOTHING_DEASSERTSL",
                          "NEGATESL_NOTHING",
                          "DEASSERTSL_ASSERTSL",
