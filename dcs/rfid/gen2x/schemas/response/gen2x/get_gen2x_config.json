{
    "title": "get_gen2x_config_response",
    "description": "Response for get_gen2x_config command \u2014 returns current Gen2X configuration",
    "type": "object",
    "required": [
        "command",
        "command_id",
        "payload",
        "response"
    ],
    "properties": {
        "command": {
            "type": "string",
            "const": "get_impinjGen2X",
            "description": "MQTT command name that was executed"
        },
        "command_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier correlating this response to the original request"
        },
        "payload": {
            "type": "object",
            "description": "Last saved Gen2X feature. Exactly one feature object is present after any successful PUT. If Gen2X has never been configured, payload is an empty object.",
            "properties": {
                "fastID": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Whether FastID is enabled"
                        }
                    },
                    "description": "FastID configuration (present only if previously configured)",
                    "required": [
                        "enabled"
                    ]
                },
                "tagProtect": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": [
                                "enableTagProtection",
                                "disableTagProtection",
                                "enableTagVisibility",
                                "disableTagVisibility"
                            ],
                            "description": "Current protection action applied to the tag"
                        },
                        "password": {
                            "type": "string",
                            "description": "8-character hexadecimal 32-bit password used for tag protection"
                        },
                        "tagID": {
                            "type": "string",
                            "description": "Hexadecimal EPC of the protected tag",
                            "pattern": "^[0-9A-Fa-f]+$"
                        },
                        "enableShortRange": {
                            "type": "boolean",
                            "description": "Whether short-range protection mode is enabled"
                        }
                    },
                    "description": "Protected Mode configuration (present only if previously configured)",
                    "required": [
                        "action",
                        "password"
                    ]
                },
                "tagFocus": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Whether TagFocus is enabled"
                        }
                    },
                    "description": "TagFocus configuration (present only if previously configured)",
                    "required": [
                        "enabled"
                    ]
                },
                "tagQuieting": {
                    "type": "object",
                    "properties": {
                        "basic": {
                            "type": "object",
                            "description": "Basic tag quieting settings",
                            "properties": {
                                "action": {
                                    "type": "string",
                                    "enum": [
                                        "quiet",
                                        "unquiet"
                                    ],
                                    "description": "Action applied to the specified tags"
                                },
                                "tagIDs": {
                                    "type": "array",
                                    "description": "List of hexadecimal EPC strings of affected tags",
                                    "items": {
                                        "type": "string",
                                        "pattern": "^[0-9A-Fa-f]+$"
                                    }
                                }
                            }
                        },
                        "advanced": {
                            "type": "object",
                            "description": "Advanced TagQuieting configuration using Impinj Gen2X proprietary features.",
                            "required": [
                                "tagQuietMasks",
                                "target",
                                "stateAwareAction"
                            ],
                            "properties": {
                                "preSelect": {
                                    "type": "array",
                                    "description": "Optional array of SELECT operations to position tags into specific session states before applying the state-aware SELECT. Maximum 31 items allowed.",
                                    "maxItems": 31,
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "target",
                                            "action",
                                            "mask"
                                        ],
                                        "properties": {
                                            "target": {
                                                "type": "string",
                                                "description": "Session or flag to target.",
                                                "enum": [
                                                    "S0",
                                                    "S1",
                                                    "S2",
                                                    "S3",
                                                    "SL"
                                                ]
                                            },
                                            "action": {
                                                "type": "string",
                                                "description": "Action to perform on the target. For target SL, provide an SL action using ASSERTSL, DEASSERTSL, or NEGATESL. For targets S0, S1, S2, or S3, provide a session action using INVA, INVB, or FLIPAB.",
                                                "enum": [
                                                    "ASSERTSL_DEASSERTSL",
                                                    "ASSERTSL_NOTHING",
                                                    "NOTHING_DEASSERTSL",
                                                    "NEGATESL_NOTHING",
                                                    "DEASSERTSL_ASSERTSL",
                                                    "DEASSERTSL_NOTHING",
                                                    "NOTHING_ASSERTSL",
                                                    "NOTHING_NEGATESL",
                                                    "INVA_INVB",
                                                    "INVA_NOTHING",
                                                    "NOTHING_INVB",
                                                    "FLIPAB_NOTHING",
                                                    "INVB_INVA",
                                                    "INVB_NOTHING",
                                                    "NOTHING_INVA",
                                                    "NOTHING_FLIPAB"
                                                ]
                                            },
                                            "mask": {
                                                "type": "object",
                                                "description": "Memory mask for tag selection.",
                                                "required": [
                                                    "bank",
                                                    "pointer",
                                                    "length",
                                                    "value"
                                                ],
                                                "properties": {
                                                    "bank": {
                                                        "type": "string",
                                                        "description": "Memory bank to match against.",
                                                        "enum": [
                                                            "EPC",
                                                            "TID",
                                                            "USER",
                                                            "RESERVED"
                                                        ]
                                                    },
                                                    "pointer": {
                                                        "type": "integer",
                                                        "description": "Bit offset in memory bank.",
                                                        "minimum": 0,
                                                        "maximum": 65535
                                                    },
                                                    "length": {
                                                        "type": "integer",
                                                        "description": "Number of bits to match.",
                                                        "minimum": 1,
                                                        "maximum": 255
                                                    },
                                                    "value": {
                                                        "type": "string",
                                                        "description": "Hex string value to match (even length, valid hex characters).",
                                                        "pattern": "^[0-9A-Fa-f]+$"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "tagQuietMasks": {
                                    "type": "array",
                                    "description": "Session-state combinations to check. Minimum 1, maximum 3 items. No duplicate session prefixes allowed (e.g., S0A and S0B together).",
                                    "minItems": 1,
                                    "maxItems": 3,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "S0A",
                                            "S0B",
                                            "S2A",
                                            "S2B",
                                            "S3A",
                                            "S3B",
                                            "SL_ASSERT",
                                            "SL_DEASSERT"
                                        ]
                                    }
                                },
                                "target": {
                                    "type": "string",
                                    "description": "Which flag to manipulate based on state check.",
                                    "enum": [
                                        "SL",
                                        "S0",
                                        "S1",
                                        "S2",
                                        "S3"
                                    ]
                                },
                                "stateAwareAction": {
                                    "type": "string",
                                    "description": "Action to perform when tags match the tagQuietMasks pattern. For target SL, provide an SL action using ASSERTSL, DEASSERTSL, or NEGATESL. For targets S0, S1, S2, or S3, provide a session action using INVA, INVB, or FLIPAB.",
                                    "enum": [
                                        "ASSERTSL_DEASSERTSL",
                                        "ASSERTSL_NOTHING",
                                        "NOTHING_DEASSERTSL",
                                        "NEGATESL_NOTHING",
                                        "DEASSERTSL_ASSERTSL",
                                        "DEASSERTSL_NOTHING",
                                        "NOTHING_ASSERTSL",
                                        "NOTHING_NEGATESL",
                                        "INVA_INVB",
                                        "INVA_NOTHING",
                                        "NOTHING_INVB",
                                        "FLIPAB_NOTHING",
                                        "INVB_INVA",
                                        "INVB_NOTHING",
                                        "NOTHING_INVA",
                                        "NOTHING_FLIPAB"
                                    ]
                                }
                            }
                        }
                    },
                    "description": "Tag quieting configuration. Provide exactly one of basic or advanced.",
                    "oneOf": [
                        {
                            "required": [
                                "basic"
                            ]
                        },
                        {
                            "required": [
                                "advanced"
                            ]
                        }
                    ]
                }
            },
            "maxProperties": 1
        },
        "response": {
            "type": "string",
            "enum": [
                "success",
                "failure"
            ],
            "description": "Response status indicating success or failure"
        }
    },
    "examples": [
        {
            "command": "get_impinjGen2X",
            "command_id": "9d744286-7b97-40b8-9e91-190df0334557",
            "payload": {
                "fastID": {
                    "enabled": true
                }
            },
            "response": "success"
        },
        {
            "command": "get_impinjGen2X",
            "command_id": "9d744286-7b97-40b8-9e91-190df0334557",
            "payload": {
                "fastID": {
                    "enabled": false
                }
            },
            "response": "success"
        },
        {
            "command": "get_impinjGen2X",
            "command_id": "9d744286-7b97-40b8-9e91-190df0334557",
            "payload": {
                "tagFocus": {
                    "enabled": true
                }
            },
            "response": "success"
        },
        {
            "command": "get_impinjGen2X",
            "command_id": "9d744286-7b97-40b8-9e91-190df0334557",
            "payload": {
                "tagProtect": {
                    "action": "enableTagProtection",
                    "password": "77777777",
                    "tagID": "e2801191a5030069073b426d",
                    "enableShortRange": true
                }
            },
            "response": "success"
        },
        {
            "command": "get_impinjGen2X",
            "command_id": "9d744286-7b97-40b8-9e91-190df0334557",
            "payload": {
                "tagQuieting": {
                    "basic": {
                        "action": "quiet",
                        "tagIDs": [
                            "e2801191a5030069073b426d"
                        ]
                    }
                }
            },
            "response": "success"
        },
        {
            "command": "get_impinjGen2X",
            "command_id": "9d744286-7b97-40b8-9e91-190df0334557",
            "payload": {
                "tagQuieting": {
                    "advanced": {
                        "preSelect": [
                            {
                                "target": "SL",
                                "action": "ASSERTSL_NOTHING",
                                "mask": {
                                    "bank": "EPC",
                                    "pointer": 32,
                                    "length": 96,
                                    "value": "E280123456789012345678AB"
                                }
                            },
                            {
                                "target": "S2",
                                "action": "INVB_INVA",
                                "mask": {
                                    "bank": "EPC",
                                    "pointer": 32,
                                    "length": 96,
                                    "value": "E280AABBCCDDEEFF11223344"
                                }
                            }
                        ],
                        "tagQuietMasks": [
                            "SL_ASSERT",
                            "S2B"
                        ],
                        "target": "SL",
                        "stateAwareAction": "ASSERTSL_DEASSERTSL"
                    }
                }
            },
            "response": "success"
        }
    ]
}
